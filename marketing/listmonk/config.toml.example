[app]
address = "0.0.0.0:9000"

# Database
[db]
host = "listmonk-db"
port = 5432
user = "listmonk"
password = "listmonk"
database = "listmonk"
ssl_mode = "disable"

# Admin credentials (change these!)
admin_username = "admin"
admin_password = "admin"

# SMTP — replace with your provider (Mailgun, SES, Postmark, etc.)
[smtp]
enabled = true
host = "smtp.example.com"
port = 587
username = ""
password = ""
auth_protocol = "login"
tls_type = "STARTTLS"
tls_skip_verify = false

from_email = "hello@marsnme.com"
from_name = "MarsNMe"

# Queue and concurrency
[queue]
batch_size = 1000
concurrency = 10
max_msg_retries = 4
requeue_on_error = true

[privacy]
allow_blacklist = true
allow_export = true
allow_wipe = true
exportable = ["subscriptions", "campaign_views", "link_clicks"]

[upload]
provider = "filesystem"
filesystem_upload_path = "./uploads"
