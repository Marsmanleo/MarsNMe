# Cloudflare KV Namespace ID for MCP_ROUTING binding
# Get this from: npx wrangler kv namespace create MCP_ROUTING
# Or list existing: npx wrangler kv namespace list
KV_NAMESPACE_ID=your_kv_namespace_id_here

# 32-byte encryption key for at-rest secret encryption in KV.
# Accepts 64-char hex OR base64 for 32 raw bytes.
ROUTE_CRYPTO_KEY=replace_with_32_byte_key_hex_or_base64
