# MarsNMe / mars-memory-mcp environment template
# Copy to .env (or deployment secret store) and fill real values.

# =========================
# Core MCP gateway
# =========================
MCP_PROFILE=coco
PORT=18790
SUPABASE_BASE_URL=http://127.0.0.1:8100
SUPABASE_SERVICE_ROLE_KEY=
JINA_API_KEY=
JINA_EMBEDDING_API_URL=https://api.jina.ai/v1/embeddings
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024

# OAuth / bearer (recommended for public exposure)
MCP_REQUIRE_BEARER=true
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Optional: extend allowed short-memory source values
# Example: MCP_EXTRA_SOURCES=telegram,discord
# MCP_EXTRA_SOURCES=
# =========================
# Optional Dream Runner (self-host)
# =========================
# Public-friendly digest runner. You can use DREAM_* directly; script also supports HERMES_* fallback.
DREAM_ENABLED=false
DREAM_MODE=lite
DREAM_DIGEST_PROFILE=coco
DREAM_DIGEST_BODY=coco
DREAM_DIGEST_MCP_URL=http://127.0.0.1:18790/mcp
DREAM_MCP_BEARER_TOKEN=
DREAM_DIGEST_SOURCE_DIR=Dream/Digest
DREAM_DIGEST_ORIGIN=dream-coco-digest
DREAM_MAX_CHUNK_CHARS=1200

# Provider toggles (optional; mode defaults apply if omitted)
# DREAM_ENABLE_RECENT_MEMORY=true
# DREAM_ENABLE_SEMANTIC_MEMORY=true
# DREAM_ENABLE_ISSUE_SIGNALS=false
# DREAM_ENABLE_REPO_SCAN=false
# DREAM_ENABLE_SOUL_CONTEXT=false

# Optional issue/repo scan config
DREAM_GITHUB_API_BASE=https://api.github.com
DREAM_GITHUB_OWNER=
DREAM_GITHUB_REPO=
DREAM_GITHUB_GIT_USERNAME=
DREAM_GITHUB_READ_TOKEN=
DREAM_ISSUE_NUMBER=0
DREAM_ISSUE_API=
DREAM_ISSUES_LIMIT=6
DREAM_REPO_LOCAL_PATH=
DREAM_REPO_REMOTE_URL=
DREAM_REPO_SCAN_KEYWORDS=
DREAM_REPO_FULL_SCAN_TOP_FILES=120
DREAM_MEMORY_LIMIT=20
DREAM_SEMANTIC_LIMIT=6
DREAM_MEMORY_QUERIES=
DREAM_SOUL_PATHS=

# =========================
# Optional Hermes digest runner
# =========================
# Default off for open-source users. Set true only when you need digest cron ingestion.
HERMES_ENABLED=false
HERMES_DIGEST_PROFILE=coco
HERMES_DIGEST_BODY=coco
HERMES_DIGEST_MCP_URL=http://127.0.0.1:18790/mcp
HERMES_DIGEST_MCP_BEARER_TOKEN=
HERMES_DIGEST_SOURCE_DIR=Hermes/Digest
HERMES_DIGEST_ORIGIN=hermes-coco-digest
HERMES_DIGEST_MAX_CHUNK_CHARS=1200

# Hermes runtime paths (override only when needed)
HERMES_HOME=/opt/hermes-home
HERMES_PROFILE_ROOT=/opt/hermes-home/profiles
HERMES_CANONICAL_ROOT=/opt/hermes-home/canonical/AgentConfig
HERMES_ENV_FILE=/opt/hermes-home/.env
HERMES_PROFILE_ENV_FILE=/opt/hermes-home/profiles/coco/.env
MARSVAULT_PATH=

# Optional repo/issue scan config for digest synthesis
HERMES_GITHUB_API_BASE=https://api.github.com
HERMES_GITHUB_OWNER=
HERMES_GITHUB_REPO=
HERMES_GITHUB_GIT_USERNAME=
HERMES_GITHUB_READ_TOKEN=
HERMES_DIGEST_ISSUE_NUMBER=0
HERMES_DIGEST_ISSUE_API=
HERMES_DIGEST_ISSUES_LIMIT=6
HERMES_REPO_LOCAL_PATH=
HERMES_REPO_REMOTE_URL=
HERMES_REPO_SCAN_ENABLED=true
HERMES_REPO_FULL_SCAN_TOP_FILES=120
HERMES_REPO_SCAN_KEYWORDS=
HERMES_DIGEST_MEMORY_LIMIT=20
HERMES_DIGEST_SEMANTIC_LIMIT=6
HERMES_DIGEST_MEMORY_QUERIES=
HERMES_DIGEST_SOUL_PATHS=

# Optional LLM routing metadata (reserved for custom Hermes workflow integration)
HERMES_LLM_PROVIDER=openai
HERMES_MODEL=gpt-4o
HERMES_API_KEY=
HERMES_CRON_SCHEDULE=0 3 * * *
