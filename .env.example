# MarsNMe / mars-memory-mcp environment template
# Copy to .env (or deployment secret store) and fill real values.

# =========================
# Core MCP gateway
# =========================
# Use your own profile ID such as profile-a/profile-b.
# This repository still supports legacy built-in IDs `coco` and `toto` for backward compatibility.
MCP_PROFILE=profile-a
PORT=18790
SUPABASE_BASE_URL=http://127.0.0.1:8100
# SECURITY WARNING:
# SUPABASE_SERVICE_ROLE_KEY is a high-privilege server-side secret.
# Never expose this key in browsers, client apps, logs, screenshots, or public repos.
# For client-side use cases, prefer SUPABASE_ANON_KEY with strict RLS policies.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
JINA_API_KEY=
JINA_EMBEDDING_API_URL=https://api.jina.ai/v1/embeddings
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024

# OAuth / bearer (recommended for public exposure)
MCP_REQUIRE_BEARER=true
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Optional: extend allowed short-memory source values
# Example: MCP_EXTRA_SOURCES=telegram,discord
# MCP_EXTRA_SOURCES=
# =========================
# Optional Dream Runner (self-host)
# =========================
# Public-friendly digest runner.
DREAM_ENABLED=false
DREAM_MODE=lite
DREAM_DIGEST_PROFILE=profile-a
# Supported body values in current gateway: coco, toto, system
DREAM_DIGEST_BODY=system
DREAM_DIGEST_MCP_URL=http://127.0.0.1:18790/mcp
DREAM_MCP_BEARER_TOKEN=
DREAM_DIGEST_SOURCE_DIR=Dream/Digest
DREAM_DIGEST_ORIGIN=dream-profile-a-digest
DREAM_MAX_CHUNK_CHARS=1200

# Provider toggles (optional; mode defaults apply if omitted)
# DREAM_ENABLE_RECENT_MEMORY=true
# DREAM_ENABLE_SEMANTIC_MEMORY=true
# DREAM_ENABLE_ISSUE_SIGNALS=false
# DREAM_ENABLE_REPO_SCAN=false
# DREAM_ENABLE_SOUL_CONTEXT=false

# Optional issue/repo scan config
DREAM_GITHUB_API_BASE=https://api.github.com
DREAM_GITHUB_OWNER=
DREAM_GITHUB_REPO=
DREAM_GITHUB_GIT_USERNAME=
DREAM_GITHUB_READ_TOKEN=
DREAM_ISSUE_NUMBER=0
DREAM_ISSUE_API=
DREAM_ISSUES_LIMIT=6
DREAM_REPO_LOCAL_PATH=
DREAM_REPO_REMOTE_URL=
DREAM_REPO_SCAN_KEYWORDS=
DREAM_REPO_FULL_SCAN_TOP_FILES=120
DREAM_MEMORY_LIMIT=20
DREAM_SEMANTIC_LIMIT=6
DREAM_MEMORY_QUERIES=
DREAM_SOUL_PATHS=
